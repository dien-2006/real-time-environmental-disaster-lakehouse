KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9093,localhost:9094
NASA_FIRMS_MAP_KEY=
NASA_FIRMS_AREA=102.14,8.18,109.46,23.39
OPENAQ_API_KEY=

# Kafka → MinIO Bronze (endpoint without http:// or https://)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_BRONZE_BUCKET=bronze
MINIO_BRONZE_PREFIX=environment-v1

# Bronze → Silver → Gold snapshots
MINIO_SILVER_BUCKET=silver
MINIO_GOLD_BUCKET=gold
MINIO_TRANSFORM_PREFIX=environment-v1

# Spark batch transforms (Java 17/21)
SPARK_MASTER=local[2]
SPARK_SHUFFLE_PARTITIONS=8
SPARK_S3_PACKAGES=org.apache.hadoop:hadoop-aws:3.4.1
MINIO_REGION=us-east-1
